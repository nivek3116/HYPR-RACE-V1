{
    // ========================================================== //
    // CONFIGURACION GENERAL                                      //
    // ========================================================== //
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "custom/player"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/recorder",
        "group/connectivity",
        "temperature",
        "battery",
        "tray",
        "custom/idle",
        "custom/notification"
    ],

    // ========================================================== //
    // MODULOS IZQUIERDA                                          //
    // ========================================================== //
    "custom/arch": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "pkill rofi || rofi -show drun",
        "on-click-right": "$HOME/.config/hypr/scripts/btop-toggle.sh"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": true,
        "active-only": false,
        "persistent-workspaces": {
            "*": [ 1, 2, 3 ]
        }
    },
    "custom/player": {
        "exec": "$HOME/.config/waybar/scripts/player.sh",
        "return-type": "json",
        "tooltip": true,
        "max-length": 50
    },

    // ========================================================== //
    // MODULOS CENTRO                                             //
    // ========================================================== //
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // ========================================================== //
    // MODULOS DERECHA                                            //
    // ========================================================== //
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth"
        ]
    },
    "network": {
        "interval": 5,
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-linked": "󰖩",
        "format-disconnected": "󰖪",
        "format-disabled": "󰖪",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/scripts/quick_menu_client wifi",
        "on-click-right": "nm-connection-editor"
    },
    "bluetooth": {
        "interval": 5,
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/scripts/quick_menu_client bt",
        "on-click-right": "blueman-manager"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°",
        "format-critical": "󰔏 {temperatureC}°",
        "tooltip": false,
        "on-click": "$HOME/.config/hypr/scripts/btop-toggle.sh"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "<span font='16px'>{icon}</span>   {capacity}%",
        "format-charging": "<span font='16px'>{icon}</span>   {capacity}%",
        "format-plugged": "<span font='16px'>{icon}</span>   {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip": true,
        "tooltip-format": "{capacity}% ({time})",
        "tooltip-format-charging": "{capacity}% - Cargando ({time})",
        "tooltip-format-plugged": "{capacity}% - Conectado",
        "on-click": "$HOME/.config/waybar/scripts/quick_menu_client battery"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true
    },
    "custom/idle": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/hypr/scripts/idle-status.sh",
        "signal": 10,
        "on-click": "$HOME/.config/hypr/scripts/idle-toggle.sh",
        "interval": "once",
        "tooltip": true
    },
    "custom/recorder": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/record-status.sh",
        "signal": 11,
        "interval": 2,
        "on-click": "$HOME/.config/hypr/scripts/screen-record.sh",
        "tooltip": true
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<span foreground='#ffffff'><sup></sup></span>",
            "none": "󰂚",
            "dnd-notification": "󰂛<span foreground='#ef4444'><sup></sup></span>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<span foreground='#ffffff'><sup></sup></span>",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛<span foreground='#ef4444'><sup></sup></span>",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
