/* ========================================================== */
/* CONFIGURACION GENERAL                                      */
/* ========================================================== */
configuration {
    modi:                "drun";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    terminal:            "kitty";
    display-drun:        "";
    drun-display-format: "{name}";
    drun-match-fields:   "name";
    matching:            "regex";
    tokenize:            false;
    case-sensitive:      false;
    sorting-method:      "normal";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    cycle:               false;
    scroll-method:       0;
}

/* ========================================================== */
/* VARIABLES Y COLORES GLOBALES                               */
/* ========================================================== */
* {
    bg:               rgba(0, 0, 0, 0.50);
    search-bg:        rgba(255, 255, 255, 0.06);
    text:             #FFFFFF;
    muted:            #94A3B8;
    accent:           #FFFFFF;
    accent-soft:      rgba(255, 255, 255, 0.12);
    accent-border:    rgba(255, 255, 255, 0.25);
    border-col:       rgba(255, 255, 255, 0.15);

    background-color: transparent;
    text-color:       @text;
    font:             "Poppins Medium 12";
}

/* ========================================================== */
/* VENTANA PRINCIPAL                                          */
/* ========================================================== */
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            680px;
    background-color: @bg;
    border:           0px;
    border-radius:    16px;
    padding:          14px;
}

/* ========================================================== */
/* CONTENEDORES PRINCIPALES                                   */
/* ========================================================== */
mainbox {
    orientation:      vertical;
    children:         [ inputbar, listview ];
    spacing:          10px;
    background-color: transparent;
    border:           0px;
    padding:          0px;
}

inputbar {
    orientation:      horizontal;
    children:         [ entry ];
    background-color: @search-bg;
    border:           0px;
    border-radius:    10px;
    padding:          12px 14px;
    margin:           0px;
}

entry {
    expand:            true;
    background-color:  transparent;
    text-color:        @text;
    placeholder:       "Buscar aplicaciones...";
    placeholder-color: @muted;
    vertical-align:    0.5;
    border:            0px;
    padding:           0px;
    margin:            0px;
}

/* ========================================================== */
/* LISTA DE APLICACIONES                                      */
/* ========================================================== */
listview {
    columns:          1;
    lines:            8;
    fixed-height:     false;
    dynamic:          true;
    cycle:            false;
    scrollbar:        false;
    spacing:          4px;
    padding:          0px;
    margin:           0px;
    border:           0px;
    background-color: transparent;
}

/* ========================================================== */
/* ELEMENTOS Y ESTADOS                                        */
/* ========================================================== */
element {
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
    background-color: transparent;
    border:           0px;
    border-radius:    10px;
    padding:          8px 12px;
    spacing:          14px;
}

element normal.normal,
element alternate.normal,
element active.normal,
element urgent.normal {
    background-color: transparent;
    text-color:       @text;
}

element selected.normal,
element selected.alternate,
element selected.active,
element selected.urgent {
    background-color: @accent-soft;
    text-color:       #FFFFFF;
    border:           0px;
}

element-icon {
    size:             40px;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    expand:           true;
    background-color: transparent;
    text-color:       @text;
    vertical-align:   0.5;
    highlight:        none;
}
